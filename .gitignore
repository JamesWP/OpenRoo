*.log
*.log.[1-9]
**/*.sav
karoo_hooks.dll
/build/
/build64/
Karoo.exe
Karoo.cfg
Karoo.exe.orig.xml
*.pyc
__pycache__/
debug.gdb
.claude/worktrees

# Recordings and determinism hash logs (test artifacts)
*.rec
*.hash
replaytest-*.json
!tests/recordings/*.rec

# Save fixtures are committed test data, not the live SavedGames/ slots that
# **/*.sav above deliberately ignores. Without this, restoring a fixture would
# depend on files nobody could clone.
!tests/saves/**/*.sav

# The game's own all-levels dump, written into the game directory whenever L is
# held during Game::LoadSounds. It is a *test output*, not source: the baseline
# it is compared against lives in tests/levelreport/ (tools/levelreport.py).
LevelReport.txt
ScriptTexts.txt
LeoRecords.txt
!tests/levelreport/*.txt

# DrawSceneObjects golden-output fixture run output (dsogolden.cpp, since removed).
# A test output, like LevelReport.txt above: the baseline it is compared
# against lives in tests/rendertrace/ (tools/dsogolden.py).
karoo_dso_golden.txt
!tests/rendertrace/*.txt

KarooOwn.exe

# The game data, imported from your own copy by tools/import_assets.py
/game/

# Where launch.sh runs the game: what it writes, plus links into game/
/run/

# SDL3 MinGW package, from tools/fetch_sdl3.sh
/third_party/
