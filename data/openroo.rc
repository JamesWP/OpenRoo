/* openroo.rc -- the resources compiled into KarooOwn.exe.
 *
 * All source; nothing is taken from the game's exe.
 *
 *   DIALOG     104 launcher, 110 device (display driver and mode)
 *   ICON       106 window/taskbar icon, openroo.ico (windres numbers its
 *              images)
 *   RCDATA     200-206 launcher bitmaps (background; play, setup, quit
 *              off/focus), cut from data/launcher/ into build/obj/ by
 *              tools/slice_launcher.py; ids are windev/launcher.cpp's
 *   VERSIONINFO 1 our own name and version
 *
 * FORMAT: dialog templates must stay DIALOG (not DIALOGEX) and controls
 * keep their order.  The launcher's owner-drawn buttons name the Button
 * class by its atom 0x80 -- windres writes a class *name* for "Button".  An
 * explicit LTEXT style replaces the default WS_GROUP, so it is restated.
 * Control ids are the ones windev/launcher.cpp uses.
 */
#include <windows.h>
#pragma code_page(65001)

#define IDD_LAUNCHER    104
#define IDD_DEVICE      110

#define IDC_STATIC      -1
#define IDC_DRIVERS     1008
#define IDC_MODES       1010
#define IDC_SETUP       1010    /* launcher button; same id as IDC_MODES */
#define IDC_PLAY        1013

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
106 ICON "openroo.ico"
200 RCDATA "launcher_bg.bmp"
201 RCDATA "launcher_play_off.bmp"
202 RCDATA "launcher_play_foc.bmp"
203 RCDATA "launcher_setup_off.bmp"
204 RCDATA "launcher_setup_foc.bmp"
205 RCDATA "launcher_quit_off.bmp"
206 RCDATA "launcher_quit_foc.bmp"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "Open'Roo"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "KarooOwn"
            VALUE "OriginalFilename", "KarooOwn.exe"
            VALUE "ProductName", "Open'Roo"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

/* The launcher's buttons are owner-drawn from bitmaps; their text is
 * never shown. */
IDD_LAUNCHER DIALOG 0, 0, 262, 246
STYLE WS_POPUP | WS_MINIMIZEBOX | DS_CENTER
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Play", IDC_PLAY, 0x80, BS_OWNERDRAW | BS_CENTER | BS_VCENTER | BS_NOTIFY | WS_TABSTOP, 7, 7, 248, 45
    CONTROL         "Setup", IDC_SETUP, 0x80, BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 7, 61, 248, 47
    CONTROL         "Quit", IDCANCEL, 0x80, BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 7, 117, 248, 49
END

IDD_DEVICE DIALOG 0, 0, 200, 82
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Setup"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 89, 61, 50, 14
    COMBOBOX        IDC_DRIVERS, 48, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Device:", IDC_STATIC, 7, 7, 38, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 48, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Mode:", IDC_STATIC, 7, 28, 21, 8
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 61, 50, 14
    LTEXT           "Shadows need a 24- or 32-bit colour mode.", IDC_STATIC, 7, 46, 186, 8
END
