/* karoo.rc -- the resources of Karoo.exe.orig, carried in our own binary.
 *
 * The dialogs are source, below: each compiles to the original's template
 * byte for byte (windres, compared against the game's RT_DIALOG data).  The
 * launcher's window shape is built from launcher_region.png into
 * rgn_111.bin in the build directory (tools/png_to_rgn.py), again byte for
 * byte.  The icon is ours (karoo.ico: 16, 32 and 48 px, 32-bit with
 * alpha).  The version block is still the game's own data, extracted
 * from your copy of Ka'roo into game/res/ by tools/import_assets.py
 * (extract_rsrc.py) and compiled raw under their original type, id and
 * language.  resources.h says which module holds them.
 *
 *   dialogs  104 launcher (de), 110 device (en) -- the two we use;
 *            102 (de), 117 (fr), 118 (it), 119 (es) -- unused localisations
 *            of the device dialog
 *   ICON                   106 window/taskbar icon (windres numbers its images)
 *   "RGN"                  111 launcher window shape (RGNDATA)
 *   type 16 RT_VERSION     1
 *
 * FORMAT: templates must stay DIALOG (not DIALOGEX), controls keep their
 * order, and the launcher's owner-drawn buttons name the Button class by its
 * atom 0x80 -- windres writes a class *name* for "Button", which the
 * original does not.  An explicit LTEXT style replaces the default WS_GROUP,
 * so it is restated.  Control ids are the ones launcherdialogs.cpp uses.
 */
#include <windows.h>
#pragma code_page(65001)

#define IDD_LAUNCHER    104
#define IDD_DEVICE      110
#define IDD_DEVICE_DE   102
#define IDD_DEVICE_FR   117
#define IDD_DEVICE_IT   118
#define IDD_DEVICE_ES   119

#define IDC_STATIC      -1
#define IDC_DRIVERS     1008
#define IDC_MODES       1010
#define IDC_SETUP       1010    /* launcher button; same id as IDC_MODES */
#define IDC_PLAY        1013

LANGUAGE 0x07, 0x01
106 ICON "karoo.ico"
111 RGN "rgn_111.bin"
1   16 "res/version_1.bin"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
IDD_LAUNCHER DIALOG 0, 0, 262, 246
STYLE WS_POPUP | DS_CENTER
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Spielen", IDC_PLAY, 0x80, BS_OWNERDRAW | BS_CENTER | BS_VCENTER | BS_NOTIFY | WS_TABSTOP, 7, 7, 248, 45
    CONTROL         "Einstellungen", IDC_SETUP, 0x80, BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 7, 61, 248, 47
    CONTROL         "Ende", IDCANCEL, 0x80, BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 7, 117, 248, 49
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_DEVICE DIALOG 0, 0, 200, 82
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Setup"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 89, 61, 50, 14
    COMBOBOX        IDC_DRIVERS, 48, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Device:", IDC_STATIC, 7, 7, 38, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 48, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Mode:", IDC_STATIC, 7, 28, 21, 8
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 61, 50, 14
    LTEXT           "Hint: Shadows are only in 24/32 bit color modes available.", IDC_STATIC, 7, 46, 186, 8
END

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
IDD_DEVICE_DE DIALOG 0, 0, 200, 82
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Setup"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 89, 61, 50, 14
    COMBOBOX        IDC_DRIVERS, 48, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Grafikkarte:", IDC_STATIC, 7, 7, 38, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 48, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Auflösung:", IDC_STATIC, 7, 28, 34, 8
    PUSHBUTTON      "Abbrechen", IDCANCEL, 143, 61, 50, 14
    LTEXT           "Hinweis: Schatten sind nur bei 24/32 Bit Farbtiefe möglich.", IDC_STATIC, 7, 46, 186, 8
END

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH
IDD_DEVICE_FR DIALOG 0, 0, 216, 90
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Configuration"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 105, 69, 50, 14
    COMBOBOX        IDC_DRIVERS, 64, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Carte graphique:", IDC_STATIC, 7, 7, 54, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 64, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Résolution:", IDC_STATIC, 7, 28, 36, 8
    PUSHBUTTON      "Annuler", IDCANCEL, 159, 69, 50, 14
    LTEXT           "Remarque: les ombres ne sont disponibles qu'en résolution \ncouleur 24/32 bits.", IDC_STATIC, 7, 46, 202, 17
END

LANGUAGE LANG_ITALIAN, SUBLANG_ITALIAN
IDD_DEVICE_IT DIALOG 0, 0, 216, 90
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Impostazioni"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 105, 69, 50, 14
    COMBOBOX        IDC_DRIVERS, 64, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Scheda grafica:", IDC_STATIC, 7, 7, 52, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 64, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Risoluzione:", IDC_STATIC, 7, 28, 39, 8
    PUSHBUTTON      "Annulla", IDCANCEL, 159, 69, 50, 14
    LTEXT           "Avvertenza: Ombre disponibili solo nella risoluzione a colori a\n24/32 bit.", IDC_STATIC, 7, 46, 202, 17
END

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN
IDD_DEVICE_ES DIALOG 0, 0, 222, 90
STYLE WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Configuración"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Aceptar", IDOK, 111, 69, 50, 14
    COMBOBOX        IDC_DRIVERS, 70, 7, 145, 194, CBS_SORT | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tarjeta de gráficos:", IDC_STATIC, 7, 7, 62, 13, SS_CENTERIMAGE | WS_GROUP
    COMBOBOX        IDC_MODES, 70, 26, 145, 87, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Resolución:", IDC_STATIC, 7, 28, 38, 8
    PUSHBUTTON      "Cancelar", IDCANCEL, 165, 69, 50, 14
    LTEXT           "Nota: Para ejecutar las sombras en pantalla se requiere una resolución de color de 24/32 bits.", IDC_STATIC, 7, 46, 208, 18
END
